---
const baseUrl = import.meta.env.BASE_URL;

export interface TeamMember {
  name: string;
  jpg: string;
  webp: string;
  url?: string;
}

interface Props {
  members: TeamMember[];
}

const { members } = Astro.props;
---

<section class="team" aria-labelledby="team-title">
  <h2 id="team-title">Equipo</h2>
  <ul class="team-grid">
    {members.map((member) => (
      <li class="member">
        {member.url ? (
          <a 
            href={member.url} 
            target="_blank" 
            rel="noopener noreferrer" 
            class="member-link" 
            aria-label={`Perfil de ${member.name}`}
          >
            <div class="member-img-wrapper">
              <picture>
                <source srcset={`${baseUrl}assets/profiles/${member.webp}`} type="image/webp" />
                <img src={`${baseUrl}assets/profiles/${member.jpg}`} alt={`Retrato de ${member.name}`} width="160" height="160" loading="lazy" />
              </picture>
              <span class="member-badge" aria-hidden="true">↗</span>
            </div>
            <p class="member-name">{member.name}</p>
          </a>
        ) : (
          <div class="member-static">
            <div class="member-img-wrapper">
              <picture>
                <source srcset={`${baseUrl}assets/profiles/${member.webp}`} type="image/webp" />
                <img src={`${baseUrl}assets/profiles/${member.jpg}`} alt={`Retrato de ${member.name}`} width="160" height="160" loading="lazy" />
              </picture>
            </div>
            <p class="member-name">{member.name}</p>
          </div>
        )}
      </li>
    ))}
  </ul>
</section>
