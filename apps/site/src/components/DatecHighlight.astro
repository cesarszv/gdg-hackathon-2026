---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const baseUrl = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<aside class="datec-card" aria-label="Agradecimiento y video de la visita a Datec">
  <p class="datec-title">
    {t('datec.title_prefix')}<a href="https://www.datec.com.bo/" target="_blank" rel="noopener noreferrer">Datec</a>{t('datec.title_suffix')}
  </p>
  <div class="datec-video-container">
    <video src={`${baseUrl}assets/datec.mp4`} controls preload="metadata" playsinline aria-label={t('datec.video_aria')}>
      {t('datec.video_fallback')}
    </video>
  </div>
</aside>
