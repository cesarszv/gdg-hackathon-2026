---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const baseUrl = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<div class="pitch-card-container">
  <h3 style="margin-top: 0;">{t('pitch.title')}</h3>
  <p>{t('pitch.desc')}</p>
  <ul class="docs-list">
    <li><a href={`${baseUrl}docs/entregables_obligatorios/GreenSpark_documento_unificado_renderizado.pdf`}>{t('pitch.doc_link')}</a></li>
  </ul>
  <figure class="video" style="margin-top: 0.8em;">
    <video src={`${baseUrl}docs/pitch/PITCH.MP4`} controls preload="metadata" playsinline width="640" height="360" aria-labelledby="pitch-cap">
      {t('pitch.video_fallback')}
    </video>
    <figcaption id="pitch-cap">{t('pitch.video_cap')}</figcaption>
  </figure>
</div>
