---
import { getLangFromUrl, useTranslations } from '../i18n/utils';

const baseUrl = import.meta.env.BASE_URL;
const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
---

<section class="winners-section" aria-label={t('winners.alt')}>
  <figure class="winners-card">
    <img 
      src={`${baseUrl}assets/ganadores.png`} 
      alt={t('winners.alt')} 
      width="1200" 
      height="675" 
      loading="lazy"
      decoding="async"
    />
  </figure>
</section>
